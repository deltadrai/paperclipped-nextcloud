{
  "name": "paperclipped-nextcloud",
  "version": "0.2.1",
  "description": "Paperclip plugin: give agents their own Nextcloud user, mailbox and Nextcloud MCP access (needs the paperclipped-nextcloud server)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deltadrai/paperclipped-nextcloud.git",
    "directory": "plugin"
  },
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "nextcloud",
    "docker-mailserver",
    "mcp"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.1023.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.0",
    "react": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
